        "complex": Compose(steps: 24),
        "complex_symmetric": Compose(steps: 18, symmetric: true),
        "complex_big": Compose(steps: 60),
        "complex_huge": Compose(steps: 160),
        // Proportions: the same units on bigger grids; stairs and parapets
