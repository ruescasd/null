        "pillar_split": Split(depth: 1, gap: 0.6, min_width: 2.5, then: "pillar_band"),
        "pillar_cells": Cells(size: 2.5, gap: 0.3, then: "pillar_band"),
        "pillar_band": Facade(height: (2, 5), panel: 1.7, storey: 1.9, depth: (0.1, 0.5), fill: 0.45,
