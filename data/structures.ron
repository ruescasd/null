    forms: {
        // ---- Lab candidates (see `lab:` at the end) ----
        // A blank shaft circled by projecting walkway rings.
        "lab_ring": Extrude(height: (1.2, 2), tone: 0.03, then: "lab_shaft_body"),
        "lab_shaft_body": Neck(by: (5, 7), height: (8, 22), then: "lab_shaft_next"),
        "lab_shaft_next": Choose([(40, "lab_ring"), (1, "lab_shaft_top")]),
        "lab_shaft_top": Inset(by: (5, 7), then: "c_crown_split"),
        // A bundle of pipe-like prisms of different heights.
        "lab_organ": Cells(size: 5, gap: 0.4, then: "lab_pipe"),
        "lab_pipe": Extrude(height: (20, 140), then: "lab_pipe_cap"),
        "lab_pipe_cap": Choose([(3, "nothing"), (1, "lab_pipe_crown")]),
        "lab_pipe_crown": Inset(by: (0.4, 0.8), then: "lab_pipe_crown_block"),
        "lab_pipe_crown_block": Extrude(height: (1, 4), tone: 0.03),
        // Slabs stacked, each shifted along the long axis: cantilevers.
        "lab_cant": Extrude(height: (5, 9), then: "lab_cant_next"),
        "lab_cant_next": Choose([(8, "lab_cant_shift"), (1, "nothing")]),
        "lab_cant_shift": Shift(by: (4, 10), along: true, then: "lab_cant"),
        // A slender stem carrying a wide cap.
        "lab_stem": Inset(by: (16, 19), then: "lab_stem_shaft"),
        "lab_stem_shaft": Extrude(height: (60, 110), then: "lab_cap"),
        "lab_cap": Extrude(height: (10, 16), taper: (-5, -4), then: "lab_cap_top"),
        "lab_cap_top": Extrude(height: (2, 4), taper: (0.15, 0.3)),
        // Earthworks and frames on a flat complex.
        "lab_heizer": Split(depth: 2, gap: 10, min_width: 20, then: "lab_heizer_piece"),
        "lab_heizer_piece": Choose([(3, "lab_berm"), (1, "lab_frame"), (1, "nothing")]),
        "lab_berm": Extrude(height: (6, 16), taper: (0.4, 0.7), tone: 0.02),
        "lab_frame": Rim(width: 2.5, height: (10, 18), gates: 1),
        // Vertebrae: segments of dense ribs with necks between.
        "lab_rib_seg": Facade(height: (6, 10), panel: 1.0, storey: 20, depth: (1, 2.5), fill: 0.9,
            then: "lab_rib_neck"),
        "lab_rib_neck": Neck(by: (2, 3.5), height: (1.5, 3), then: "lab_rib_next"),
        "lab_rib_next": Choose([(10, "lab_rib_seg"), (1, "nothing")]),

        // Blocks: a few storeys; the top may set back and rise again.
        "block": Facade(height: (5, 18), panel: 3, storey: 3.2, depth: (0.25, 1.1), fill: 0.6, then: "block_top"),
        "block_top": Choose([(4, "nothing"), (3, "setback"), (1, "parapet")]),
        "setback": Inset(by: (1.5, 5), then: "block"),
        "parapet": Rim(width: 0.5, height: (1.1, 1.1), gates: 0),
        "low_block": Inset(by: (3, 6), then: "block"),
        // A tall tower, slightly battered.
        "monolith": Facade(height: (12, 24), panel: 4, storey: 4, depth: (0.4, 1.6), fill: 0.55, tone: -0.03,
            then: "monolith_next"),
        "monolith_next": Choose([(4, "monolith_groove"), (1, "setback"), (1, "nothing")]),
        "monolith_groove": Neck(by: (0.8, 1.6), height: (1.2, 2.4), then: "monolith"),

        // Blocks cut along the plate's own lines, with streets between.
        "blocks": Split(depth: 2, gap: 2.5, min_width: 16, then: "block_or_gap"),
        "block_or_gap": Choose([(6, "town_tower"), (4, "town_slab"), (0.5, "nothing")]),
        // Buildings of the box styles in the pieces of a plate.
        "town_tower": Inset(by: (0.5, 1.5), then: "town_tower_box"),
        "town_tower_box": Structure(style: "tower_block", proportion: (2, 4.5)),
        "town_slab": Inset(by: (0.5, 1.5), then: "town_slab_box"),
