        "complex_colossal": Compose(steps: 60, grid: (20, 13.5)),
        // Mixed grids: a colossal core, a human-scale complex round it.
        "complex_mixed": Compose(steps: 260, core: ((40, 27), 0.5, 24)),
        // Sparse lattices: big cells, most slots empty, every cell carried
