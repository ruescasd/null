// Structures: box styles and their modules, forms, the sites and colossi the
// world grows, and the lab's catalogue.
//
// The game watches this file: save it and every structure is rebuilt within
// a second. If something is wrong the error shows at the top right and the
// last good version stays up.
//
// HOW IT WORKS
// A style is a fractal rule: split a block into a grid of cells, keep some,
// and repeat inside each kept cell, `depth` times. Every final cell (a
// "leaf") is filled by a module, chosen by the style's leaf rules from where
// the leaf sat in its parent's grid.
//
// MODULES fill a cell. Inside a cell, coordinates run from -1 to 1 on each
// axis, y up. Sizes are fractions of the cell. Built in: "box", "void", "ramp".
//   Box                          the whole cell
//   Void                         nothing
//   Slab(thickness: 0.2)         a horizontal slab; add at: Middle or at: Top
//   Column(width: 0.3)           a full-height square column
//   Fin(thickness: 0.1)          a full-height plate; add axis: Z to turn it
//   Frame(bar: 0.1)              the cell's twelve edges as bars
//   Ramp                         a wedge rising towards +x; only where it is
//                                walkable (45 degrees or less), otherwise it
//                                becomes stairs
//   Stairs(rise: 0.45)           steps rising towards +x, each at most `rise`
//                                metres high (0.58 is the most you can step
//                                up without jumping); as many as the cell's
//                                height needs
//   Group([ (min: (x, y, z), max: (x, y, z), module: "name", turn: 1), ... ])
//                                parts inside the cell, each a sub-box filled
//                                by another module; turn = quarter turns
//
// STYLES
//   divisions: (x, y, z)   cells per axis at each split
//   keep:   All | Lattice | ColumnsAndRoof | Skyline | Random(0.6)
//   depth:  how many times to split
//   gap:    fraction of its cell each child fills (below 1 leaves grooves)
//   twist:  degrees each level turns relative to its parent
//   stop_chance: chance a block stops splitting early (plain masses)
//   lift:   random vertical shift of children, fraction of a cell
//   min_size: blocks smaller than this (metres) are not split
//   albedo, albedo_spread: tone
//   leaves: [ (on: Where, module: "name", weight: 1, turn: None), ... ]
//     on:   Any | Top | Summit | Bottom | Corner | Edge | Interior | Outside | Early
//           (Summit = nothing above it in the parent's grid,
//            Corner = a vertical edge of the parent, Edge = one of its faces,
//            Early = a block that stopped splitting early)
//     turn: None | Random | Outward | Inward  (Outward points +x away from
//           the parent's centre: ramps and stairs rising outwards)
//     Every matching rule is a candidate, picked by weight; with none, a box.
//
// STRUCTURES (placed box-style structures)
//   (style: "name", at: (x, z), size: (x, y, z), yaw: 0, seed: 0, sink: 0)
//   The default spawn point is at (1200, 900), looking towards +x / -z.
//
// FORMS grow buildings from plates. A form works on a polygon (a plate, or
// a piece of one) standing at some height, and usually hands its results to
// another form by name ("nothing" is built in). Pairs are random ranges.
//   Extrude(height: (8, 20), taper: (0, 0), lean: 0, tone: 0, then: "name")
//                      a prism of the polygon; taper narrows it towards the
//                      top (1 = to a point), lean shifts its top sideways by
//                      up to that many metres, tone lightens (+) or darkens
//                      (-) it; `then` grows on its top
//   Facade(height: (8, 20), panel: 3, storey: 3.5, depth: (0.3, 1.2), fill: 0.55,
//          tone: 0, then: "name")
//                      a prism whose faces are covered with panels: a grid
//                      of cells `panel` wide and `storey` high, each holding
//                      (by chance `fill`) a slab standing out `depth` with a
//                      tone of its own; `then` grows on its top
//   Inset(by: (1, 3), then: "name")
//                      the polygon shrunk on every side: setbacks, margins
//   Neck(by: (1, 2), height: (2, 4), then: "name")
//                      a recessed band (the polygon shrunk, this high), then
//                      `then` on the whole polygon again: grooves between bands
//   Split(depth: 2, gap: 0, min_width: 8, then: "name")
//                      cut in two across its length, `depth` times, along
//                      the plate's own lines, with `gap` metres between
//   Cells(size: 6, gap: 0, then: "name")
//                      divided into smaller plates about `size` across
//   Rim(width: 1.5, height: (4, 8), gates: 0.3, inner: "name", wall: "name")
//                      a wall along each edge, with gates by chance; `inner`
//                      grows inside it; with `wall`, each stretch of wall
//                      grows that form (and `height` is not used)
//   Pillars(width: 1.5, height: (6, 12), spacing: 12, then: "name")
//                      pillars at the corners and along the edges; `then`
//                      grows on the whole polygon at their top
//   Choose([(2, "a"), (1, "b")])   one of these, by weight
//   Stack(["a", "b"])              all of these on the same polygon
//   Structure(style: "name", height: (20, 40))   or   proportion: (1.5, 3)
//                      a structure of a box style in the biggest box that
//                      fits, so high, or that many times its narrower side
//   Compose(steps: 24, symmetric: false, grid: (6, 4.5), core: ((20, 13.5), 0.45, 40), tone: 0)
//                      a complex of walkable units at the same scale (6 m
//                      bays, 4.5 m levels): terraces, raised decks on arches,
//                      bridges, stairs joining them, parapets, porticos,
//                      grown in runs and mutated
//   Tower(height: (150, 200), width: 0, spacing: 0, tone: 0)
//                      an ordered tower transcribed from Manifold Garden in
//                      the biggest square that fits; with spacing, towers
//                      `width` across on a lattice that far apart
//   Lattice(cell: (96, 45), levels: 14, ...)
//                      the hanging city: a sparse lattice of cells (slots
//                      `cell` wide and high), most of them empty, the rest
//                      decks carrying composed units, held up by cores,
//                      beams, piers and rods (see lattice.rs for the knobs;
//                      `reactor: true` with `void` or `radial` builds the
//                      reactor city)
//   Cell(kind: "court", len: 1)
//                      one city cell on the ground, for the lab: a deck with
//                      a unit of that kind (plaza, court, terraces, gallery,
//                      tower, cascade, garden)
//   Field(n: 2), Backdrop(fore: Some("field"), kind: "wedges", count: 4, varied: true, grain: "flight")
//                      a human-scale field of cells, and colossal wedges
//                      standing behind one (see mega.rs)
//
// SITES: structures that grow out of the world by themselves.
//   site_grid: (spacing: 768, chance: 0.5)
//     The world is cut into cells about `spacing` metres wide; each holds a
//     site with probability `chance`, near its centre.
//   sites: [ (district: Floor, weight: 1, at: (x, z),
//             plates: "form", terraces: "form", terrace_chance: 0.35,
//             core: (40, 90), stairs: 0.5,
//             style: "name", size: ((min x, y, z), (max x, y, z)),
//             lift: (3, 9), rings: 3, ring_width: 22, step: 0.5), ... ]
//     district: Floor | Tiers | Stacks | Broken
//     A site picks among its district's rules by weight. Sites shrink to
//     keep clear of neighbours, canals and the placed structures.
//     at: (x, z) places a rule's one site exactly there (its district is
//     then ignored), and nowhere else.
//     The site reshapes the plates around it: a flat core `core` metres in
//     radius, `lift` metres (a random amount in the range) above the
//     surrounding ground, or below it if negative (a sunken court); `rings`
//     terraces, each `ring_width` metres wide, step from the core to the
//     ground, at heights that are multiples of `step`.
//     Each plate of the core grows the `plates` form; a `terrace_chance`
//     share of the terrace plates grow the `terraces` form. A `stairs` share
//     of the plates next to a higher one get a flight of stairs up to it
//     instead (0.45 m steps: walkable without jumping).
//     Optionally a centrepiece of a box `style` stands in the middle, of a
//     size between min and max; the core then fits around it.
//     earthwork: (shape: Square, ramps: 1)
//       slopes the ground continuously instead of in terraces, over the
//       same rings x ring_width: crisp tilted facets from the core's edge
//       to the natural ground (a mound if the core is raised, a bowl if
//       sunk); shape Round or Square, ramps reach that much further along
//       the four axes (0 none, 1 twice as far).
//     order: 300
//       an ordered site: square terraces on a regular grid of plates, the
//       centrepiece square to it, stairs up the four axes; the plates
//       around it regular too, the order fading over that many metres
//       beyond the terraces (no earthwork)
//     plinth: false leaves the ground alone (centrepiece only).
//     form: "name", footprint: (60, 120)
//       grows a form on the whole footprint instead: the big plate at the
//       centre, scaled to that many metres from its centre to its furthest
//       corner (the core then fits around it); squeezed below half its
//       smallest size, there is none. square: true uses a square (turned
//       with the earthwork) instead of the plate: a city needs the width.
//   Sites stream in within 2.5 km of you; `--opt nosites` leaves them out.
//
// COLOSSI: the same rules on a much coarser grid, for megastructures.
//   colossus_grid: (spacing: 2048, chance: 0.85)
//   colossi: [ (district: Stacks, form: "name", footprint: (90, 160), ...), ... ]
//   Ordinary sites keep clear of them; they stream in within 4.5 km.
//   Changing the sites regenerates the terrain, which takes a few seconds.
(
    modules: {
        "needle": Column(width: 0.12),
        "blade": Fin(thickness: 0.08),
        "cage": Frame(bar: 0.08),
        "terrace": Group([
            (min: (-1, -1, -1), max: (1, -0.4, 1), module: "box"),
            (min: (-1, -0.4, -1), max: (1, 0.3, 1), module: "ramp"),
        ]),
        "louvres": Group([
            (min: (-1, -1, -1), max: (1, -0.85, 1), module: "box"),
            (min: (-1, -0.45, -1), max: (1, -0.3, 1), module: "box"),
            (min: (-1, 0.1, -1), max: (1, 0.25, 1), module: "box"),
            (min: (-1, 0.65, -1), max: (1, 0.8, 1), module: "box"),
        ]),
    },

    styles: {
        "needle": (
            divisions: (3, 5, 3), keep: Lattice, depth: 3, gap: 0.9, twist: 6,
            stop_chance: 0.3, albedo: 0.1,
            leaves: [
                (on: Corner, module: "needle", weight: 1),
                (on: Corner, module: "box", weight: 1),
                (on: Edge, module: "blade", weight: 1, turn: Random),
                (on: Edge, module: "louvres", weight: 1),
                (on: Early, module: "box", weight: 3),
            ],
        ),
        // Town buildings: a lattice of floors, needles and blades at the
        // corners and edges, louvres on the faces, cages inside.
        "tower_block": (
            divisions: (3, 5, 3), keep: Lattice, depth: 2, gap: 0.9,
            stop_chance: 0.25, albedo: 0.12, albedo_spread: 0.05,
            leaves: [
                (on: Corner, module: "needle", weight: 1),
                (on: Corner, module: "box", weight: 2),
                (on: Edge, module: "blade", weight: 1, turn: Random),
                (on: Edge, module: "louvres", weight: 2),
                (on: Interior, module: "cage", weight: 1),
                (on: Early, module: "box", weight: 3),
            ],
        ),
        // A lower, wider mass with voids, louvres and fins.
        "slab_block": (
            divisions: (4, 3, 2), keep: Random(0.8), depth: 2, gap: 0.92,
            stop_chance: 0.3, albedo: 0.14, albedo_spread: 0.05,
            leaves: [
                (on: Top, module: "terrace", weight: 1, turn: Outward),
                (on: Outside, module: "louvres", weight: 2),
                (on: Outside, module: "blade", weight: 1),
                (on: Early, module: "box", weight: 3),
                (on: Any, module: "box", weight: 2),
            ],
        ),
        // A Menger-like lattice; its interior cells become open cages.
        "lattice": (
            divisions: (3, 3, 3), keep: Lattice, depth: 3, gap: 0.93, twist: 2,
            stop_chance: 0.15, albedo: 0.13,
            leaves: [
                (on: Any, module: "box", weight: 3),
                (on: Interior, module: "cage", weight: 2),
                (on: Top, module: "louvres", weight: 1),
            ],
        ),
        // A tall twisting tower of blades and louvres around solid cores.
        "spire": (
            divisions: (3, 6, 3), keep: Lattice, depth: 3, gap: 0.9, twist: 10,
            stop_chance: 0.2, albedo: 0.1,
            leaves: [
                (on: Corner, module: "needle", weight: 1),
                (on: Corner, module: "box", weight: 1),
                (on: Edge, module: "blade", weight: 1, turn: Random),
                (on: Edge, module: "louvres", weight: 1),
                (on: Early, module: "box", weight: 3),
            ],
        ),
    },

    structures: [
        // The spire: the box style that always worked.
        (style: "spire",    at: (1637, 791), size: (60, 340, 60),  seed: 2, yaw: 20),
    ],

    forms: {
        "block": Facade(height: (5, 18), panel: 3, storey: 3.2, depth: (0.25, 1.1), fill: 0.6, then: "block_top"),
        "block_top": Choose([(4, "nothing"), (3, "setback"), (1, "parapet")]),
        "setback": Inset(by: (1.5, 5), then: "block"),
        "parapet": Rim(width: 0.5, height: (1.1, 1.1), gates: 0),
        "low_block": Inset(by: (3, 6), then: "block"),
        "blocks": Split(depth: 2, gap: 2.5, min_width: 16, then: "block_or_gap"),
        "block_or_gap": Choose([(6, "town_tower"), (4, "town_slab"), (0.5, "nothing")]),
        // Buildings of the box styles in the pieces of a plate.
        "town_tower": Inset(by: (0.5, 1.5), then: "town_tower_box"),
        "town_tower_box": Structure(style: "tower_block", proportion: (2, 4.5)),
        "town_slab": Inset(by: (0.5, 1.5), then: "town_slab_box"),
        "town_slab_box": Structure(style: "slab_block", proportion: (0.4, 0.9)),
        "court": Rim(width: 1.6, height: (5, 11), gates: 0.5, inner: "court_inside"),
        "court_inside": Choose([(2, "nothing"), (1, "low_block"), (1, "dais")]),
        // A stepped dais: low terraces, each a mantle or less.
        "dais": Extrude(height: (0.9, 1.8), then: "dais_up"),
        "dais_up": Choose([(3, "dais_step"), (1, "nothing"), (1, "low_block")]),
        "dais_step": Inset(by: (2.5, 5), then: "dais"),
        // Paving broken into small plates, some lifted.
        "paving": Cells(size: 6, gap: 0.5, then: "slab_or_not"),
        "slab_or_not": Choose([(3, "nothing"), (2, "slab")]),
        "slab": Extrude(height: (0.4, 1.4)),
        // An old box style on a plate.
        "lattice_block": Inset(by: (2, 4), then: "lattice_box"),
        "lattice_box": Structure(style: "lattice", height: (20, 50)),

        // Terrain pillars (the stacks' ground): the mesher grows this on each
        // pillar plate and scales it to the pillar's height. Banded shafts,
        // sometimes split by a slot, with grooves, setbacks and small crowns.
        "pillar": Choose([(3, "pillar_band"), (2, "pillar_split"), (1, "pillar_cells")]),
        "pillar_split": Split(depth: 1, gap: 0.6, min_width: 2.5, then: "pillar_band"),
        "pillar_cells": Cells(size: 2.5, gap: 0.3, then: "pillar_band"),
        "pillar_band": Facade(height: (2, 5), panel: 1.7, storey: 1.9, depth: (0.1, 0.5), fill: 0.45,
            then: "pillar_next"),
        "pillar_next": Choose([(6, "pillar_neck"), (2, "pillar_setback"), (1, "pillar_crown")]),
        "pillar_neck": Neck(by: (0.2, 0.5), height: (0.4, 1), then: "pillar_band"),
        "pillar_setback": Inset(by: (0.4, 1.2), then: "pillar_band"),
        "pillar_crown": Cells(size: 1.5, gap: 0.3, then: "pillar_crown_piece"),
        "pillar_crown_piece": Choose([(1, "nothing"), (2, "pillar_crown_block")]),
        "pillar_crown_block": Extrude(height: (0.5, 2.5), tone: 0.02),

        // What grows on a plate, by kind of site.
        "towers": Inset(by: (1.5, 4), then: "towers_plate"),
        "towers_plate": Choose([(3, "towers_spire"), (3, "blocks"), (1, "lattice_block"), (1, "nothing")]),
        "towers_spire": Structure(style: "tower_block", proportion: (3, 6)),
        "ruin": Choose([(3, "paving"), (1, "court"), (3, "nothing"), (1, "low_block"), (1, "dais")]),
        "terrace": Choose([(2, "paving"), (1, "court"), (2, "dais"), (1, "low_block")]),

        // Colossi: hundreds of metres, with detail at every scale.
        // Bands with grooves between them, now and then a setback, and a
        // crown when they stop.
        "c_band": Facade(height: (14, 32), panel: 8, storey: 6, depth: (0.8, 3), fill: 0.5, then: "c_band_next"),
        "c_band_next": Choose([(14, "c_groove"), (3, "c_setback"), (1, "c_crown")]),
        "c_groove": Neck(by: (1.2, 2.5), height: (2, 4), then: "c_band"),
        "c_setback": Inset(by: (4, 12), then: "c_band"),
        "c_crown": Choose([(2, "c_crown_split"), (1, "nothing")]),
        "c_crown_split": Split(depth: 2, gap: 3, min_width: 10, then: "c_crown_piece"),
        "c_crown_piece": Extrude(height: (6, 40), then: "c_crown_more"),
        "c_crown_more": Choose([(2, "nothing"), (1, "c_crown_up")]),
        "c_crown_up": Inset(by: (2, 5), then: "c_crown_piece"),

        // Stacks: colossal spires of the box style that works in the spire
        // site, two or so side by side, straight out of the mound.
        "colossus_needles": Inset(by: (5, 15), then: "needles"),
        "needles": Split(depth: 1, gap: 12, min_width: 35, then: "needle"),
        "needle": Choose([(4, "needle_spire"), (1, "needle_tall")]),
        "needle_spire": Structure(style: "needle", proportion: (4, 7)),
        "needle_tall": Structure(style: "needle", proportion: (7, 10)),

        "complex_mixed": Compose(steps: 260, core: ((40, 27), 0.5, 24)),
        "city_tall": Lattice(cell: (96, 45), levels: 14, bars: 0.5, content: 8, cluster: 0.7, thin: 0.15, cores: 0.35),
        "unit_court": Cell(kind: "court"),
        "unit_terraces": Cell(kind: "terraces"),
        "unit_gallery": Cell(kind: "gallery", len: 2),
        "unit_tower": Cell(kind: "tower"),
        "unit_plaza": Cell(kind: "plaza"),
        "unit_cascade": Cell(kind: "cascade"),
        "unit_garden": Cell(kind: "garden"),
        "field": Field(n: 2),
        "back_plain": Backdrop(fore: Some("field"), kind: "wedges", count: 4, varied: true),
        "back_flight": Backdrop(fore: Some("field"), kind: "wedges", count: 4, varied: true, grain: "flight"),
        "reactor_square": Lattice(cell: (96, 45), levels: 24, bars: 0.5, content: 8, cluster: 0.7, thin: 0.06, cores: 0.45, void: 1000, reactor: true, cables: 30),
        "reactor_round": Lattice(cell: (96, 45), levels: 24, bars: 0.5, content: 8, cluster: 0.7, thin: 0.06, cores: 0.45, fill: 0.3, radial: Some((600, 3)), arcs: 4, reactor: true, cables: 30),
        "mg_tower": Tower(height: (170, 170)),
        "colossus_ruin": Cells(size: 45, gap: 6, then: "ruin_shaft"),
        "ruin_shaft": Choose([(2, "c_band"), (2, "r_band"), (2, "ruin_stub"), (2, "nothing")]),
        "r_band": Extrude(height: (14, 32), lean: 3, then: "r_next"),
        "r_next": Choose([(10, "r_groove"), (1, "c_crown")]),
        "r_groove": Neck(by: (1, 2), height: (2, 4), then: "r_band"),
        "ruin_stub": Extrude(height: (10, 60), taper: (0, 0.4), lean: 6, then: "c_crown_split"),
    },

    site_grid: (spacing: 768, chance: 0.55),
    // For now (pending the game's direction) only placed examples of the
    // kinds that passed review; `at` puts a rule's one site exactly there.
    sites: [
        // An ordered site: square terraces climbed by stairs on the four
        // axes, the plates around it regular, the order fading outwards.
        (at: (2633, 2004), style: "spire", size: ((40, 200, 40), (80, 420, 80)), plates: "towers",
            terraces: "ruin", terrace_chance: 0.2, lift: (10, 16), rings: 4, ring_width: 20, step: 3, order: 300),
        // Towers on a round mound among the stacks' pillars.
        (at: (2698, 413), plates: "towers", terraces: "ruin", core: (50, 100), lift: (4, 10), earthwork: (shape: Round)),
    ],

    colossus_grid: (spacing: 2048, chance: 0.85),
    colossi: [
        // Needles from a square mound with ramps, and shattered shafts from
        // a low mound: one placed example of each.
        (at: (2801, 834), form: "colossus_needles", footprint: (90, 160), lift: (12, 25), rings: 3, ring_width: 30,
            terraces: "ruin", earthwork: (shape: Square, ramps: 0.6)),
        (at: (4872, 3097), form: "colossus_ruin", footprint: (140, 220), lift: (8, 18), rings: 3, ring_width: 30,
            terraces: "ruin", earthwork: (shape: Round, ramps: 0.3)),
        // A few hanging cities (the lab's city_tall) in the open floor, on
        // low square platforms with ramps.
        (district: Floor, form: "city_tall", footprint: (560, 600), square: true, lift: (2, 5), rings: 2,
            ring_width: 40, terraces: "terrace", earthwork: (shape: Square, ramps: 1)),
    ],

    // The lab (`--opt lab`): candidate patterns in a row on flat ground,
    // judged on their own. `form` + `footprint` (metres to the corners), or
    // `style` + `size`; `variants` samples side by side; `note` says what
    // each is. For now the lab holds the catalogue: the patterns that passed
    // review (`--focus name` shows one).
    lab: [
        (name: "city_tall", form: "city_tall", footprint: 880, variants: 1, note: "The hanging city: a sparse lattice of decks, each a composed unit"),
        (name: "reactor_square", form: "reactor_square", footprint: 1150, variants: 1, note: "A square hanging city round a void, a reactor in it"),
        (name: "reactor_round", form: "reactor_round", footprint: 1150, variants: 1, note: "The city in rings round the reactor"),
        (name: "complex_mixed", form: "complex_mixed", footprint: 760, variants: 1, note: "A composed complex: a colossal core in a human-scale fabric, grand stairs"),
        (name: "mg_tower", form: "mg_tower", footprint: 42, variants: 1, note: "Yardstick: the Manifold Garden tower"),
        (name: "unit_plaza", form: "unit_plaza", footprint: 110, variants: 2, note: "Stoas, a rotunda or tower, gateways"),
        (name: "unit_court", form: "unit_court", footprint: 110, variants: 2, note: "Halls round a court; some with a giant loggia on top"),
        (name: "unit_terraces", form: "unit_terraces", footprint: 110, variants: 1, note: "Terraces on the axis"),
        (name: "unit_gallery", form: "unit_gallery", footprint: 200, variants: 2, note: "A hall, towers, a colonnade or vault"),
        (name: "unit_tower", form: "unit_tower", footprint: 110, variants: 1, note: "Towers on a podium"),
        (name: "unit_cascade", form: "unit_cascade", footprint: 110, variants: 3, note: "Trays cantilevered off a solid core (after Fallingwater)"),
        (name: "unit_garden", form: "unit_garden", footprint: 110, variants: 2, note: "A pool on the axis, pergolas, pavilions, obelisks, a gateway"),
        (name: "back_plain", form: "back_plain", footprint: 1300, variants: 1, note: "Colossal wedges behind a human-scale field"),
        (name: "back_flight", form: "back_flight", footprint: 1300, variants: 1, note: "Wedges with a human-scale flight up the middle"),
    ],
)
