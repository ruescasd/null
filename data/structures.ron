        "towers_spire": Structure(style: "tower_block", proportion: (3, 6)),
        "ruin": Choose([(3, "paving"), (1, "court"), (3, "nothing"), (1, "low_block"), (1, "dais")]),
        "terrace": Choose([(2, "paving"), (1, "court"), (2, "dais"), (1, "low_block")]),

        // Colossi: hundreds of metres, with detail at every scale.
