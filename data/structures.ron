        "unit_tower": Cell(kind: "tower"),
        "unit_tower_old": Cell(kind: "tower", old: true),
        "unit_plaza": Cell(kind: "plaza"),
        "unit_plaza_old": Cell(kind: "plaza", old: true),
        "unit_cascade": Cell(kind: "cascade"),
