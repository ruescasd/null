// Structures: modules, styles, and where to build test structures.
//
// The game watches this file: save it and every structure is rebuilt within
// a second. If something is wrong the error shows at the top right and the
// last good version stays up.
//
// HOW IT WORKS
// A style is a fractal rule: split a block into a grid of cells, keep some,
// and repeat inside each kept cell, `depth` times. Every final cell (a
// "leaf") is filled by a module, chosen by the style's leaf rules from where
// the leaf sat in its parent's grid.
//
// MODULES fill a cell. Inside a cell, coordinates run from -1 to 1 on each
// axis, y up. Sizes are fractions of the cell. Built in: "box", "void", "ramp".
//   Box                          the whole cell
//   Void                         nothing
//   Slab(thickness: 0.2)         a horizontal slab; add at: Middle or at: Top
//   Column(width: 0.3)           a full-height square column
//   Fin(thickness: 0.1)          a full-height plate; add axis: Z to turn it
//   Frame(bar: 0.1)              the cell's twelve edges as bars
//   Conduits(core: 0.45, bow: 0.25)
//                                the cell made of conduits: a core (fraction
//                                of its cross-section, 0 for none) wrapped in
//                                tubes packed along its longest side, some
//                                bowing out loose (chance `bow`); cells under
//                                1.2 m across stay solid
//   Ramp                         a wedge rising towards +x; only where it is
//                                walkable (45 degrees or less), otherwise it
//                                becomes stairs
//   Stairs(rise: 0.45)           steps rising towards +x, each at most `rise`
//                                metres high (0.58 is the most you can step
//                                up without jumping); as many as the cell's
//                                height needs
//   Group([ (min: (x, y, z), max: (x, y, z), module: "name", turn: 1), ... ])
//                                parts inside the cell, each a sub-box filled
//                                by another module; turn = quarter turns
//   Structure(style: "name", height: (0.5, 1.0))
//                                a whole structure of that style built in the
//                                cell, standing on its floor, a random
//                                fraction of the cell's height; for regions
//                                of plots (nests up to three deep)
//
// STYLES
//   divisions: (x, y, z)   cells per axis at each split
//   keep:   All | Lattice | ColumnsAndRoof | Skyline | Random(0.6)
//           | Massif(0.8)  (columns falling from the centre by that much,
//             at every level: a mountain of mountains)
//   depth:  how many times to split
//   gap:    fraction of its cell each child fills (below 1 leaves grooves)
//   twist:  degrees each level turns relative to its parent
//   stop_chance: chance a block stops splitting early (plain masses)
//   lift:   random vertical shift of children, fraction of a cell
//   min_size: blocks smaller than this (metres) are not split
//   stairs: at most this many flights of stairs along the cliffs between
//           levels
//   envelope: [Box(min: (x, y, z), max: (x, y, z)), Plane(normal: (x, y, z), offset: 0.5)]
//           cuts taken out of the box before it is filled, in its own -1..1
//           coordinates: what a box contains, what lies beyond a plane
//   cuts:   this many more cuts picked at random: corners (L shapes),
//           notches, strips (setbacks), undercuts (overhangs), slopes
//   symmetric: true mirrors the random cuts across x and z
//   albedo, albedo_spread: tone
//   leaves: [ (on: Where, module: "name", weight: 1, turn: None), ... ]
//     on:   Any | Top | Summit | Bottom | Corner | Edge | Interior | Outside | Early
//           (Summit = nothing above it in the parent's grid,
//            Corner = a vertical edge of the parent, Edge = one of its faces,
//            Early = a block that stopped splitting early)
//     turn: None | Random | Outward | Inward  (Outward points +x away from
//           the parent's centre: ramps and stairs rising outwards)
//     Every matching rule is a candidate, picked by weight; with none, a box.
//
// STRUCTURES (test placements)
//   (style: "name", at: (x, z), size: (x, y, z), yaw: 0, seed: 0, sink: 0)
//   The default spawn point is at (1200, 900), looking towards +x / -z.
//
// FORMS grow buildings from plates. A form works on a polygon (a plate, or
// a piece of one) standing at some height, and usually hands its results to
// another form by name ("nothing" is built in). Pairs are random ranges.
//   Extrude(height: (8, 20), taper: (0, 0), lean: 0, tone: 0, then: "name")
//                      a prism of the polygon; taper narrows it towards the
//                      top (1 = to a point), lean shifts its top sideways by
//                      up to that many metres, tone lightens (+) or darkens
//                      (-) it; `then` grows on its top
//   Facade(height: (8, 20), panel: 3, storey: 3.5, depth: (0.3, 1.2), fill: 0.55,
//          tone: 0, then: "name")
//                      a prism whose faces are covered with panels: a grid
//                      of cells `panel` wide and `storey` high, each holding
//                      (by chance `fill`) a slab standing out `depth` with a
//                      tone of its own; `then` grows on its top
//   Inset(by: (1, 3), then: "name")
//                      the polygon shrunk on every side: setbacks, margins
//   Neck(by: (1, 2), height: (2, 4), then: "name")
//                      a recessed band (the polygon shrunk, this high), then
//                      `then` on the whole polygon again: grooves between bands
//   Split(depth: 2, gap: 0, min_width: 8, then: "name")
//                      cut in two across its length, `depth` times, along
//                      the plate's own lines, with `gap` metres between
//   Cells(size: 6, gap: 0, then: "name")
//                      divided into smaller plates about `size` across
//   Rim(width: 1.5, height: (4, 8), gates: 0.3, inner: "name", wall: "name")
//                      a wall along each edge, with gates by chance; `inner`
//                      grows inside it; with `wall`, each stretch of wall
//                      grows that form (and `height` is not used)
//   Pillars(width: 1.5, height: (6, 12), spacing: 12, then: "name")
//                      pillars at the corners and along the edges; `then`
//                      grows on the whole polygon at their top
//   Choose([(2, "a"), (1, "b")])   one of these, by weight
//   Stack(["a", "b"])              all of these on the same polygon
//   Structure(style: "name", height: (20, 40))   or   proportion: (1.5, 3)
//                      a structure of a box style in the biggest box that
//                      fits, so high, or that many times its narrower side
//   Rack(height: (40, 60), storey: (3.5, 5), bay: (3, 5), depth: (2.2, 3.5),
//        frame: 0.45, core: false, strange: false, tone: 0, then: "name")
//                      an open frame along each edge, one bay deep, its bays
//                      packed with pipes, tanks, hoses or machinery (or left
//                      empty); `core` fills the inside with a dark mass;
//                      `then` grows on the whole polygon at its top;
//                      `strange`: no frame, but a network of pipes on the
//                      core's faces (use with `core`), climbing, switching
//                      lanes, splitting, with bare wall between its knots
//   Relief(height: (45, 65), depth: 2, tone: 0, then: "name")
//                      a prism whose faces are carved into themselves: a
//                      skin `depth` thick cut into recesses within recesses
//                      (sunk relief); `then` grows on top
//   Compose(steps: 24, symmetric: false, grid: (6, 4.5), core: ((20, 13.5), 0.45, 40), tone: 0)
//                      a complex of walkable units at the same scale (6 m
//                      bays, 4.5 m levels): terraces, raised decks on arches,
//                      bridges, stairs joining them, parapets, porticos,
//                      grown in runs and mutated
//   Fractal(height: (90, 90), depth: 3, leaf: Box, copies: [(at: (x, y, z), scale: (x, y, z), turn: 0, stop: false, leaf: Box), ...])
//                      a shape made of copies of itself: each copy placed
//                      (the parent's -1..1 frame), scaled and turned, recursing
//                      `depth` times unless it stops; pieces drawn as Box,
//                      Wedge, Pyramid, Tetrahedron or Style("name")
//   Sierpinski(height: (90, 90), depth: 5, tetrahedron: false, tone: 0)
//                      a Sierpinski pyramid (five half-size pyramids, each
//                      made the same way) or tetrahedron (four)
//   Tower(height: (150, 200), width: 0, spacing: 0, tone: 0)
//                      an ordered tower transcribed from Manifold Garden in
//                      the biggest square that fits; with spacing, towers
//                      `width` across on a lattice that far apart
//   Bastions(height: (90, 130), count: 1, tone: 0)
//                      round towers of bare wall with rows of deep arches,
//                      a door, a stair spiralling up the outside to each
//                      arcade, ledges; arched bridges between neighbours
//   Curtains(height: (90, 130), tone: 0)
//                      walls round an open shaft, sheaves of long cables
//                      crossing the void and hanging down the walls
//   Cluster(height: (55, 80), tone: 0)
//                      a mass made of cylinders: drums of very different
//                      sizes packed and fused, taller in the middle, a few
//                      lying across, small tubes sagging and winding over them
//   Roots(reach: (45, 70), depth: 2.5, buried: false, tone: 0)
//                      the same network spreading out across the ground
//                      from each edge, `reach` metres, half sunk or on
//                      supports, thinning and diving in as it goes; with
//                      `buried`, conduits instead: few, straight, sunk to
//                      their crowns, flush hatches where they turn or end
//
// SITES: structures that grow out of the world by themselves.
//   site_grid: (spacing: 768, chance: 0.5)
//     The world is cut into cells about `spacing` metres wide; each holds a
//     site with probability `chance`, near its centre.
//   sites: [ (district: Floor, weight: 1,
//             plates: "form", terraces: "form", terrace_chance: 0.35,
//             core: (40, 90), stairs: 0.5,
//             style: "name", size: ((min x, y, z), (max x, y, z)),
//             lift: (3, 9), rings: 3, ring_width: 22, step: 0.5), ... ]
//     district: Floor | Tiers | Stacks | Broken
//     A site picks among its district's rules by weight. Sites shrink to
//     keep clear of neighbours, canals and the test structures.
//     The site reshapes the plates around it: a flat core `core` metres in
//     radius, `lift` metres (a random amount in the range) above the
//     surrounding ground, or below it if negative (a sunken court); `rings`
//     terraces, each `ring_width` metres wide, step from the core to the
//     ground, at heights that are multiples of `step`.
//     Each plate of the core grows the `plates` form; a `terrace_chance`
//     share of the terrace plates grow the `terraces` form. A `stairs` share
//     of the plates next to a higher one get a flight of stairs up to it
//     instead (0.45 m steps: walkable without jumping).
//     Optionally a centrepiece of a box `style` stands in the middle, of a
//     size between min and max; the core then fits around it.
//     earthwork: (shape: Square, ramps: 1)
//       slopes the ground continuously instead of in terraces, over the
//       same rings x ring_width: crisp tilted facets from the core's edge
//       to the natural ground (a mound if the core is raised, a bowl if
//       sunk); shape Round or Square, ramps reach that much further along
//       the four axes (0 none, 1 twice as far).
//     order: 300
//       an ordered site: square terraces on a regular grid of plates, the
//       centrepiece square to it, stairs up the four axes; the plates
//       around it regular too, the order fading over that many metres
//       beyond the terraces (no earthwork)
//     plinth: false leaves the ground alone (centrepiece only).
//     form: "name", footprint: (60, 120)
//       grows a form on the whole footprint instead: the big plate at the
//       centre, scaled to that many metres from its centre to its furthest
//       corner (the core then fits around it).
//   Sites stream in within 2.5 km of you; `--opt nosites` leaves them out.
//
// COLOSSI: the same rules on a much coarser grid, for megastructures.
//   colossus_grid: (spacing: 2048, chance: 0.85)
//   colossi: [ (district: Stacks, form: "name", footprint: (90, 160), ...), ... ]
//   Ordinary sites keep clear of them; they stream in within 4.5 km.
//   Changing the sites regenerates the terrain, which takes a few seconds.
(
    modules: {
        "floor": Slab(thickness: 0.2),
        "roof": Slab(thickness: 0.15, at: Top),
        "pier": Column(width: 0.35),
        "needle": Column(width: 0.12),
        // Cells made of conduits: a core wrapped in a loom of tubes, or a
        // loose bundle of tubes with no core.
        "loom": Conduits(core: 0.45, bow: 0.2),
        "cables": Conduits(core: 0, bow: 0.45),
        "blade": Fin(thickness: 0.08),
        "blade_z": Fin(thickness: 0.08, axis: Z),
        "cage": Frame(bar: 0.08),
        "steps": Stairs(rise: 0.45),

        // A low block with a ramp running up from its top.
        "terrace": Group([
            (min: (-1, -1, -1), max: (1, -0.4, 1), module: "box"),
            (min: (-1, -0.4, -1), max: (1, 0.3, 1), module: "ramp"),
        ]),
        // Two piers carrying a lintel.
        "gate": Group([
            (min: (-1, -1, -1), max: (-0.55, 1, 1), module: "box"),
            (min: (0.55, -1, -1), max: (1, 1, 1), module: "box"),
            (min: (-0.55, 0.5, -1), max: (0.55, 1, 1), module: "box"),
        ]),
        // A stack of thin slabs.
        "louvres": Group([
            (min: (-1, -1, -1), max: (1, -0.85, 1), module: "box"),
            (min: (-1, -0.45, -1), max: (1, -0.3, 1), module: "box"),
            (min: (-1, 0.1, -1), max: (1, 0.25, 1), module: "box"),
            (min: (-1, 0.65, -1), max: (1, 0.8, 1), module: "box"),
        ]),
        // A slab on four needles, like a table.
        "table": Group([
            (min: (-1, 0.6, -1), max: (1, 1, 1), module: "box"),
            (min: (-1, -1, -1), max: (-0.7, 0.6, -0.7), module: "box"),
            (min: (0.7, -1, -1), max: (1, 0.6, -0.7), module: "box"),
            (min: (-1, -1, 0.7), max: (-0.7, 0.6, 1), module: "box"),
            (min: (0.7, -1, 0.7), max: (1, 0.6, 1), module: "box"),
        ]),

        // Whole structures, for filling the plots of a region.
        "plot_ziggurat": Structure(style: "ziggurat", height: (0.25, 0.45)),
        "plot_spire": Structure(style: "spire", height: (0.7, 1.0)),
        "plot_hall": Structure(style: "hall", height: (0.12, 0.2)),
        "plot_tables": Structure(style: "tables", height: (0.2, 0.35)),
        "plot_fins": Structure(style: "fins", height: (0.15, 0.3)),
        "plot_lattice": Structure(style: "lattice", height: (0.2, 0.4)),
        // A thin paved plate covering the plot (2 m in a 200 m high region).
        "plaza": Slab(thickness: 0.01),
    },

    styles: {
        // Lab: an open lattice tower of frames (BLAME!'s trusses).
        "truss": (
            divisions: (2, 6, 2), keep: All, depth: 2, gap: 0.96, albedo: 0.1,
            leaves: [
                (on: Any, module: "cage", weight: 6),
                (on: Bottom, module: "box", weight: 1),
                (on: Early, module: "box", weight: 2),
            ],
        ),
        // The spire's recipe, a little lighter, for colossal needles.
        "needle": (
            divisions: (3, 5, 3), keep: Lattice, depth: 3, gap: 0.9, twist: 6,
            stop_chance: 0.3, albedo: 0.1,
            leaves: [
                (on: Corner, module: "needle", weight: 1),
                (on: Corner, module: "box", weight: 1),
                (on: Edge, module: "blade", weight: 1, turn: Random),
                (on: Edge, module: "louvres", weight: 1),
                (on: Early, module: "box", weight: 3),
            ],
        ),
        // Town buildings: a lattice of floors, needles and blades at the
        // corners and edges, louvres on the faces, cages inside.
        "tower_block": (
            divisions: (3, 5, 3), keep: Lattice, depth: 2, gap: 0.9,
            stop_chance: 0.25, albedo: 0.12, albedo_spread: 0.05,
            leaves: [
                (on: Corner, module: "needle", weight: 1),
                (on: Corner, module: "box", weight: 2),
                (on: Edge, module: "blade", weight: 1, turn: Random),
                (on: Edge, module: "louvres", weight: 2),
                (on: Interior, module: "cage", weight: 1),
                (on: Early, module: "box", weight: 3),
            ],
        ),
        // A lower, wider mass with voids, louvres and fins.
        "slab_block": (
            divisions: (4, 3, 2), keep: Random(0.8), depth: 2, gap: 0.92,
            stop_chance: 0.3, albedo: 0.14, albedo_spread: 0.05,
            leaves: [
                (on: Top, module: "terrace", weight: 1, turn: Outward),
                (on: Outside, module: "louvres", weight: 2),
                (on: Outside, module: "blade", weight: 1),
                (on: Early, module: "box", weight: 3),
                (on: Any, module: "box", weight: 2),
            ],
        ),
        // A Menger-like lattice; its interior cells become open cages.
        "lattice": (
            divisions: (3, 3, 3), keep: Lattice, depth: 3, gap: 0.93, twist: 2,
            stop_chance: 0.15, albedo: 0.13,
            leaves: [
                (on: Any, module: "box", weight: 3),
                (on: Interior, module: "cage", weight: 2),
                (on: Top, module: "louvres", weight: 1),
            ],
        ),
        // A tall twisting tower of blades and louvres around solid cores.
        "spire": (
            divisions: (3, 6, 3), keep: Lattice, depth: 3, gap: 0.9, twist: 10,
            stop_chance: 0.2, albedo: 0.1,
            leaves: [
                (on: Corner, module: "needle", weight: 1),
                (on: Corner, module: "box", weight: 1),
                (on: Edge, module: "blade", weight: 1, turn: Random),
                (on: Edge, module: "louvres", weight: 1),
                (on: Early, module: "box", weight: 3),
            ],
        ),
        // Piers carrying roofs, arcades within arcades, with gates.
        "hall": (
            divisions: (5, 2, 3), keep: ColumnsAndRoof, depth: 3, gap: 0.95,
            stop_chance: 0.1, albedo: 0.16,
            leaves: [
                (on: Top, module: "roof", weight: 2),
                (on: Top, module: "box", weight: 1),
                (on: Corner, module: "pier", weight: 2),
                (on: Edge, module: "gate", weight: 2, turn: Outward),
                (on: Any, module: "box", weight: 1),
            ],
        ),
        // Stepped massing climbed by ramps and stairs that face outwards.
        "ziggurat": (
            divisions: (4, 4, 4), keep: Skyline, depth: 2, gap: 0.92,
            stop_chance: 0.2, albedo: 0.14,
            leaves: [
                (on: Top, module: "terrace", weight: 2, turn: Outward),
                (on: Top, module: "steps", weight: 1, turn: Outward),
                (on: Any, module: "box", weight: 2),
            ],
        ),
        // A block whose faces are rows of blades: a brise-soleil facade.
        "fins": (
            divisions: (6, 4, 2), keep: All, depth: 2, gap: 0.97, albedo: 0.18,
            leaves: [
                (on: Outside, module: "blade", weight: 2),
                (on: Outside, module: "blade_z", weight: 1),
                (on: Interior, module: "void"),
                (on: Bottom, module: "box", weight: 1),
            ],
        ),
        // Lab: a mountain of mountains. Every split keeps columns falling
        // from the centre to broken edges, so the massif is made of smaller
        // massifs down to a few metres; ramps rising inwards on the summits.
        "massif": (
            divisions: (4, 3, 4), keep: Massif(0.85), depth: 3, gap: 0.96,
            stop_chance: 0.03, min_size: 3, albedo: 0.12, albedo_spread: 0.04,
            leaves: [
                (on: Summit, module: "ramp", weight: 2, turn: Inward),
                (on: Summit, module: "box", weight: 2),
                (on: Outside, module: "louvres", weight: 1),
                (on: Early, module: "box", weight: 3),
                (on: Any, module: "box", weight: 3),
            ],
        ),
        // Rougher: thirds, steeper falls, children lifted and turned a little.
        "massif_rough": (
            divisions: (3, 3, 3), keep: Massif(1.0), depth: 4, gap: 0.9, twist: 3,
            stop_chance: 0.1, lift: 0.12, min_size: 1.5, albedo: 0.11, albedo_spread: 0.05,
            leaves: [
                (on: Summit, module: "ramp", weight: 1, turn: Inward),
                (on: Corner, module: "needle", weight: 1),
                (on: Edge, module: "blade", weight: 1, turn: Random),
                (on: Early, module: "box", weight: 3),
                (on: Any, module: "box", weight: 3),
            ],
        ),
        // Lab: made of conduits. The spire's recipe with looms of tubes
        // among its cells; a wall of looms and blocks; the massif with
        // looms. The tubes are part of the mass, not laid on it.
        // Lab: the massif and the ziggurat with stairs climbing between
        // their levels.
        "massif_stairs": (
            divisions: (4, 3, 4), keep: Massif(0.85), depth: 3, gap: 0.96,
            stop_chance: 0.03, min_size: 3, albedo: 0.12, albedo_spread: 0.04, stairs: 60,
            leaves: [
                (on: Early, module: "box", weight: 3),
                (on: Any, module: "box", weight: 3),
            ],
        ),
        "ziggurat_stairs": (
            divisions: (4, 4, 4), keep: Skyline, depth: 2, gap: 1.0,
            stop_chance: 0.2, albedo: 0.14, stairs: 40,
            leaves: [(on: Any, module: "box", weight: 1)],
        ),
        "loom_spire": (
            divisions: (3, 6, 3), keep: Lattice, depth: 3, gap: 0.9, twist: 10,
            stop_chance: 0.2, albedo: 0.1,
            leaves: [
                (on: Corner, module: "needle", weight: 1),
                (on: Corner, module: "loom", weight: 1),
                (on: Edge, module: "loom", weight: 1),
                (on: Edge, module: "blade", weight: 1, turn: Random),
                (on: Edge, module: "louvres", weight: 1),
                (on: Early, module: "box", weight: 2),
                (on: Early, module: "loom", weight: 1),
                (on: Interior, module: "cables", weight: 1),
            ],
        ),
        "loom_wall": (
            divisions: (5, 4, 2), keep: Lattice, depth: 3, gap: 0.94,
            stop_chance: 0.15, albedo: 0.11,
            leaves: [
                (on: Any, module: "loom", weight: 3),
                (on: Any, module: "box", weight: 2),
                (on: Edge, module: "cables", weight: 1),
                (on: Early, module: "box", weight: 2),
            ],
        ),
        "loom_massif": (
            divisions: (4, 3, 4), keep: Massif(0.85), depth: 3, gap: 0.96,
            stop_chance: 0.03, min_size: 3, albedo: 0.12, albedo_spread: 0.04,
            leaves: [
                (on: Summit, module: "ramp", weight: 2, turn: Inward),
                (on: Any, module: "loom", weight: 2),
                (on: Outside, module: "cables", weight: 1),
                (on: Early, module: "box", weight: 3),
                (on: Any, module: "box", weight: 3),
            ],
        ),
        // The family (lab): the spire's recipe filling carved envelopes
        // instead of the same box every time.
        // Two random cuts: corners, notches, setbacks, overhangs, slopes.
        "spire_carved": (
            divisions: (3, 6, 3), keep: Lattice, depth: 3, gap: 0.9, twist: 0,
            stop_chance: 0.2, albedo: 0.1, cuts: 2,
            leaves: [
                (on: Corner, module: "needle", weight: 1),
                (on: Corner, module: "box", weight: 1),
                (on: Edge, module: "blade", weight: 1, turn: Random),
                (on: Edge, module: "louvres", weight: 1),
                (on: Early, module: "box", weight: 3),
            ],
        ),
        // One random cut, mirrored four ways.
        "spire_symmetric": (
            divisions: (3, 6, 3), keep: Lattice, depth: 3, gap: 0.9, twist: 0,
            stop_chance: 0.2, albedo: 0.1, cuts: 1, symmetric: true,
            leaves: [
                (on: Corner, module: "needle", weight: 1),
                (on: Corner, module: "box", weight: 1),
                (on: Edge, module: "blade", weight: 1, turn: Random),
                (on: Edge, module: "louvres", weight: 1),
                (on: Early, module: "box", weight: 3),
            ],
        ),
        // An ordered massif: a broad block, symmetric cuts.
        "fam_massif": (
