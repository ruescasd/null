        "rack_wall": Rack(height: (28, 36), depth: (2.5, 4), core: true, strange: true),
        // Roots (lab): the network spreading out across the ground from a
        // structure's footprint, thinning and diving in as it goes.
        "roots": Roots(reach: (55, 85)),
        "rooted_block": Stack(["rack_block_strange", "roots"]),
        "rooted_spire": Stack(["rooted_spire_tower", "roots"]),
        "rooted_spire_tower": Structure(style: "spire", height: (90, 120)),
        // Buried: conduits under the ground, only their crowns showing.
        "conduits": Roots(reach: (90, 130), buried: true),
        "conduit_block": Stack(["rack_block_strange", "conduits"]),
        "conduit_spire": Stack(["rooted_spire_tower", "conduits"]),
        "rack_block_strange": Rack(height: (40, 55), storey: (5, 8), bay: (4, 7), depth: (3, 4.5), core: true,
            strange: true, then: "rack_setback_strange"),
        "rack_setback_strange": Inset(by: (5, 9), then: "rack_upper_strange"),
        "rack_upper_strange": Rack(height: (20, 35), storey: (4, 7), depth: (2.5, 3.5), core: true, strange: true),
        "colossus_mountain": Extrude(height: (25, 45), taper: (0.12, 0.25), tone: -0.02, then: "mountain_ledge"),
        "mountain_ledge": Rim(width: 12, gates: 0.35, wall: "mountain_deco", inner: "mountain_up"),
        "mountain_up": Choose([(6, "colossus_mountain"), (1, "mountain_split"), (1, "mountain_crown")]),
        "mountain_split": Split(depth: 1, gap: 10, min_width: 40, then: "colossus_mountain"),
        "mountain_crown": Choose([(1, "c_crown_split"), (1, "towers_spire")]),
        "mountain_deco": Choose([(2, "nothing"), (3, "mountain_blocks"), (1, "mountain_platform")]),
        "mountain_blocks": Split(depth: 2, gap: 2, min_width: 8, then: "mountain_block"),
        "mountain_block": Choose([(3, "town_slab"), (1, "town_tower"), (1, "nothing")]),
        "mountain_platform": Extrude(height: (1.5, 4)),

        // Floor: a vast walled enclosure, banded walls broken by gates, and
        // something inside.
        "colossus_enclosure": Rim(width: 14, gates: 0.6, wall: "w_band", inner: "enclosure_inside"),
        "w_band": Facade(height: (10, 22), panel: 5, storey: 4.5, depth: (0.5, 1.8), fill: 0.5, then: "w_next"),
        "w_next": Choose([(5, "w_groove"), (1, "nothing")]),
        "w_groove": Neck(by: (0.8, 1.5), height: (1.5, 3), then: "w_band"),
        "enclosure_inside": Choose([(2, "lone_needle"), (1, "lone_mountain"), (1, "nothing")]),
        "lone_needle": Inset(by: (50, 90), then: "c_band"),
        "lone_mountain": Inset(by: (40, 70), then: "colossus_mountain"),

        // Broken: a shattered field of shafts, some bent as they rise.
        "colossus_ruin": Cells(size: 45, gap: 6, then: "ruin_shaft"),
        "ruin_shaft": Choose([(2, "c_band"), (2, "r_band"), (2, "ruin_stub"), (2, "nothing")]),
        "r_band": Extrude(height: (14, 32), lean: 3, then: "r_next"),
        "r_next": Choose([(10, "r_groove"), (1, "c_crown")]),
        "r_groove": Neck(by: (1, 2), height: (2, 4), then: "r_band"),
        "ruin_stub": Extrude(height: (10, 60), taper: (0, 0.4), lean: 6, then: "c_crown_split"),
    },

    site_grid: (spacing: 768, chance: 0.55),
    sites: [
        // Floor: vast plazas and towns on low square platforms with ramps;
        // the odd hall.
        (district: Floor, weight: 3, plates: "plaza", terraces: "terrace", core: (70, 130),
            lift: (1.5, 5), rings: 2, ring_width: 30, earthwork: (shape: Square, ramps: 1)),
        (district: Floor, weight: 2, plates: "town", terraces: "terrace", core: (80, 140),
            lift: (3, 8), rings: 2, ring_width: 30, earthwork: (shape: Square, ramps: 1)),
        (district: Floor, weight: 1, style: "hall", size: ((120, 30, 80), (220, 60, 140)), plates: "plaza",
            terraces: "terrace", lift: (1.5, 5), rings: 2, ring_width: 30, earthwork: (shape: Square, ramps: 0.6)),
        // Tiers: high stepped mounds in mantle-height steps, crowned.
        (district: Tiers, weight: 2, style: "ziggurat", size: ((60, 50, 80), (140, 110, 180)), plates: "ruin",
            terraces: "terrace", terrace_chance: 0.5, lift: (8, 16), rings: 5, ring_width: 16, step: 2),
        (district: Tiers, weight: 2, plates: "town", terraces: "terrace", terrace_chance: 0.5, core: (50, 90),
            lift: (8, 16), rings: 5, ring_width: 16, step: 2),
        // Stacks: towers on round mounds among the pillars.
        (district: Stacks, weight: 3, plates: "towers", terraces: "ruin", core: (50, 100), lift: (4, 10),
            earthwork: (shape: Round)),
        // An ordered site: square terraces climbed by stairs on the four
        // axes, the plates around it regular, the order fading outwards.
        (district: Stacks, weight: 1, style: "spire", size: ((40, 200, 40), (80, 420, 80)), plates: "towers",
            terraces: "ruin", terrace_chance: 0.2, lift: (10, 16), rings: 4, ring_width: 20, step: 3, order: 300),
        // Broken: ruins on mounds or sunk into bowls.
        (district: Broken, weight: 3, plates: "ruin", terraces: "ruin", core: (60, 110), lift: (-10, 8),
            earthwork: (shape: Round)),
        (district: Broken, weight: 1, plates: "town", terraces: "ruin", core: (60, 100), lift: (-8, 4),
            earthwork: (shape: Square)),
        (district: Broken, weight: 1, style: "lattice", size: ((100, 60, 100), (180, 120, 180)), plates: "ruin",
            terraces: "ruin", lift: (-10, 8), earthwork: (shape: Round, ramps: 0.4)),
    ],

    colossus_grid: (spacing: 2048, chance: 0.85),
    colossi: [
        // Each colossus emerges from an earthwork: needles from square
        // mounds with ramps, mountains from round ones, enclosures sunk in
        // square bowls, shattered shafts from low mounds.
        (district: Stacks, form: "colossus_needles", footprint: (90, 160), lift: (12, 25), rings: 3, ring_width: 30,
            terraces: "ruin", earthwork: (shape: Square, ramps: 0.6)),
        (district: Tiers, form: "colossus_mountain", footprint: (140, 220), lift: (10, 20), rings: 4, ring_width: 24,
            step: 2, terraces: "terrace", terrace_chance: 0.5, earthwork: (shape: Round, ramps: 1)),
        (district: Floor, form: "colossus_enclosure", footprint: (180, 260), lift: (-10, -4), rings: 2, ring_width: 40,
            terraces: "terrace", earthwork: (shape: Square)),
        (district: Broken, form: "colossus_ruin", footprint: (140, 220), lift: (8, 18), rings: 3, ring_width: 30,
            terraces: "ruin", earthwork: (shape: Round, ramps: 0.3)),
    ],

    // Pipework that belongs to structures (see dressing.rs): bundles of
    // ducts rising along faces (from the ground or partway up) with collars
    // and junction boxes, turning into walls or running along them; bundles
    // spanning gaps to the mass facing them; cables sagging between tops.
    //   pipes: chance per open face   bundle: pipes per bundle   width: metres
    //   collars: flange spacing (0 none)   brackets: bracket/clamp spacing
    //   members: chance a long thin piece carries pipes along it, clamped
    //   junctions, spans, cables: chances
    dressings: {
        "industrial": (pipes: 0.35, bundle: (1, 3), width: (0.4, 1.2), collars: 6, brackets: 3.5,
            junctions: 0.25, spans: 0.35, cables: 0.3, members: 0.35),
    },

    // The lab (`--opt lab`): candidate patterns in a row on flat ground,
    // judged on their own. `form` + `footprint` (metres to the corners), or
    // `style` + `size`; `dress` adds pipework; `variants` samples side by
    // side; `note` says what each tries.
    // Batch 1: organ kept; shaft_rings, cantilever_stack, earthworks,
    //   mountain, truss, ribbed promising (lacking detail); stem_cap dropped.
    // Batch 2 (pipework): reads as structure on the truss (at a distance)
    //   and could on the mountain; cosmetic on the ring shaft, cantilever
    //   stack and spire; add-ons or errors on the ribbed vertebrae (giger).
    // Batch 3: pipework with round pipes, brackets, flanges and plates,
    //   along members, on the truss, mountain and organ only.
    lab: [
        // The backdrop lab (the unit lab and earlier candidates are still
        // defined above; add a line here to bring one back).
        (name: "back_plain", form: "back_plain", footprint: 1300, variants: 1, note: "Plain wedges (the control)"),
        (name: "back_ribs", form: "back_ribs", footprint: 1300, variants: 1, note: "Wedges ribbed across"),
        (name: "back_ridges", form: "back_ridges", footprint: 1300, variants: 1, note: "Wedges with ridges up them"),
        (name: "back_flight", form: "back_flight", footprint: 1300, variants: 1, note: "Wedges with a human-scale flight up the middle"),
        (name: "back_crossing", form: "back_crossing", footprint: 1300, variants: 1, note: "Plain wedges crossing in pairs"),
    ],
)
