        "pillar_next": Choose([(6, "pillar_neck"), (2, "pillar_setback"), (1, "pillar_crown")]),
        "pillar_neck": Neck(by: (0.2, 0.5), height: (0.4, 1), then: "pillar_band"),
        "pillar_setback": Inset(by: (0.4, 1.2), then: "pillar_band"),
        "pillar_crown": Cells(size: 1.5, gap: 0.3, then: "pillar_crown_piece"),
