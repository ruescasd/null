        "city_tall": Lattice(cell: (96, 45), levels: 14, bars: 0.5, content: 8, cluster: 0.7, thin: 0.15, cores: 0.35),
        "city_soaring": Lattice(cell: (96, 45), levels: 20, bars: 0.5, content: 8, cluster: 0.7, thin: 0.08, cores: 0.3),
        // The unit lab: one city cell on the ground per kind, the reworked
