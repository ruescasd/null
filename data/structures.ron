        "back_ribs": Backdrop(fore: Some("field"), kind: "wedges", count: 4, varied: true, grain: "ribs"),
        "back_ridges": Backdrop(fore: Some("field"), kind: "wedges", count: 4, varied: true, grain: "ridges"),
        "back_flight": Backdrop(fore: Some("field"), kind: "wedges", count: 4, varied: true, grain: "flight"),
        "back_crossing": Backdrop(fore: Some("field"), kind: "crossing", count: 4),
        // The hanging city with colossal ramps rising into it.
        "city_ramps": Lattice(cell: (96, 45), levels: 14, bars: 0.5, content: 8, cluster: 0.7, thin: 0.15, cores: 0.35, ramps: 6),
        "city_ramps_ridges": Lattice(cell: (96, 45), levels: 14, bars: 0.5, content: 8, cluster: 0.7, thin: 0.15, cores: 0.35, ramps: 6, ramp_grain: "ridges"),
        "complex_mixed_symmetric": Compose(steps: 200, symmetric: true, core: ((40, 27), 0.5, 18)),
        "complex_huge_symmetric": Compose(steps: 110, symmetric: true),
        // Shapes made of themselves (lab). A gate made of gates, drawn with
        // boxes, pyramids or tetrahedra; a stepped tower made of stepped
