// Structures: modules, styles, and where to build test structures.
//
// The game watches this file: save it and every structure is rebuilt within
// a second. If something is wrong the error shows at the top right and the
// last good version stays up.
//
// HOW IT WORKS
// A style is a fractal rule: split a block into a grid of cells, keep some,
// and repeat inside each kept cell, `depth` times. Every final cell (a
// "leaf") is filled by a module, chosen by the style's leaf rules from where
// the leaf sat in its parent's grid.
//
// MODULES fill a cell. Inside a cell, coordinates run from -1 to 1 on each
// axis, y up. Sizes are fractions of the cell. Built in: "box", "void", "ramp".
//   Box                          the whole cell
//   Void                         nothing
//   Slab(thickness: 0.2)         a horizontal slab; add at: Middle or at: Top
//   Column(width: 0.3)           a full-height square column
//   Fin(thickness: 0.1)          a full-height plate; add axis: Z to turn it
//   Frame(bar: 0.1)              the cell's twelve edges as bars
//   Ramp                         a wedge rising towards +x; only where it is
//                                walkable (45 degrees or less), otherwise it
//                                becomes stairs
//   Stairs(rise: 0.45)           steps rising towards +x, each at most `rise`
//                                metres high (0.58 is the most you can step
//                                up without jumping); as many as the cell's
//                                height needs
//   Group([ (min: (x, y, z), max: (x, y, z), module: "name", turn: 1), ... ])
//                                parts inside the cell, each a sub-box filled
//                                by another module; turn = quarter turns
//   Structure(style: "name", height: (0.5, 1.0))
//                                a whole structure of that style built in the
//                                cell, standing on its floor, a random
//                                fraction of the cell's height; for regions
//                                of plots (nests up to three deep)
//
// STYLES
//   divisions: (x, y, z)   cells per axis at each split
//   keep:   All | Lattice | ColumnsAndRoof | Skyline | Random(0.6)
//           | Massif(0.8)  (columns falling from the centre by that much,
//             at every level: a mountain of mountains)
//   depth:  how many times to split
//   gap:    fraction of its cell each child fills (below 1 leaves grooves)
//   twist:  degrees each level turns relative to its parent
//   stop_chance: chance a block stops splitting early (plain masses)
//   lift:   random vertical shift of children, fraction of a cell
//   min_size: blocks smaller than this (metres) are not split
//   albedo, albedo_spread: tone
//   leaves: [ (on: Where, module: "name", weight: 1, turn: None), ... ]
//     on:   Any | Top | Summit | Bottom | Corner | Edge | Interior | Outside | Early
//           (Summit = nothing above it in the parent's grid,
//            Corner = a vertical edge of the parent, Edge = one of its faces,
//            Early = a block that stopped splitting early)
//     turn: None | Random | Outward | Inward  (Outward points +x away from
//           the parent's centre: ramps and stairs rising outwards)
//     Every matching rule is a candidate, picked by weight; with none, a box.
//
// STRUCTURES (test placements)
//   (style: "name", at: (x, z), size: (x, y, z), yaw: 0, seed: 0, sink: 0)
//   The default spawn point is at (1200, 900), looking towards +x / -z.
//
// FORMS grow buildings from plates. A form works on a polygon (a plate, or
// a piece of one) standing at some height, and usually hands its results to
// another form by name ("nothing" is built in). Pairs are random ranges.
//   Extrude(height: (8, 20), taper: (0, 0), lean: 0, tone: 0, then: "name")
//                      a prism of the polygon; taper narrows it towards the
//                      top (1 = to a point), lean shifts its top sideways by
//                      up to that many metres, tone lightens (+) or darkens
//                      (-) it; `then` grows on its top
//   Facade(height: (8, 20), panel: 3, storey: 3.5, depth: (0.3, 1.2), fill: 0.55,
//          tone: 0, then: "name")
//                      a prism whose faces are covered with panels: a grid
//                      of cells `panel` wide and `storey` high, each holding
//                      (by chance `fill`) a slab standing out `depth` with a
//                      tone of its own; `then` grows on its top
//   Inset(by: (1, 3), then: "name")
//                      the polygon shrunk on every side: setbacks, margins
//   Neck(by: (1, 2), height: (2, 4), then: "name")
//                      a recessed band (the polygon shrunk, this high), then
//                      `then` on the whole polygon again: grooves between bands
//   Split(depth: 2, gap: 0, min_width: 8, then: "name")
//                      cut in two across its length, `depth` times, along
//                      the plate's own lines, with `gap` metres between
//   Cells(size: 6, gap: 0, then: "name")
//                      divided into smaller plates about `size` across
//   Rim(width: 1.5, height: (4, 8), gates: 0.3, inner: "name", wall: "name")
//                      a wall along each edge, with gates by chance; `inner`
//                      grows inside it; with `wall`, each stretch of wall
//                      grows that form (and `height` is not used)
//   Pillars(width: 1.5, height: (6, 12), spacing: 12, then: "name")
//                      pillars at the corners and along the edges; `then`
//                      grows on the whole polygon at their top
//   Choose([(2, "a"), (1, "b")])   one of these, by weight
//   Stack(["a", "b"])              all of these on the same polygon
//   Structure(style: "name", height: (20, 40))   or   proportion: (1.5, 3)
//                      a structure of a box style in the biggest box that
//                      fits, so high, or that many times its narrower side
//
// SITES: structures that grow out of the world by themselves.
//   site_grid: (spacing: 768, chance: 0.5)
//     The world is cut into cells about `spacing` metres wide; each holds a
//     site with probability `chance`, near its centre.
//   sites: [ (district: Floor, weight: 1,
//             plates: "form", terraces: "form", terrace_chance: 0.35,
//             core: (40, 90), stairs: 0.5,
//             style: "name", size: ((min x, y, z), (max x, y, z)),
//             lift: (3, 9), rings: 3, ring_width: 22, step: 0.5), ... ]
//     district: Floor | Tiers | Stacks | Broken
//     A site picks among its district's rules by weight. Sites shrink to
//     keep clear of neighbours, canals and the test structures.
//     The site reshapes the plates around it: a flat core `core` metres in
//     radius, `lift` metres (a random amount in the range) above the
//     surrounding ground, or below it if negative (a sunken court); `rings`
//     terraces, each `ring_width` metres wide, step from the core to the
//     ground, at heights that are multiples of `step`.
//     Each plate of the core grows the `plates` form; a `terrace_chance`
//     share of the terrace plates grow the `terraces` form. A `stairs` share
//     of the plates next to a higher one get a flight of stairs up to it
//     instead (0.45 m steps: walkable without jumping).
//     Optionally a centrepiece of a box `style` stands in the middle, of a
//     size between min and max; the core then fits around it.
//     earthwork: (shape: Square, ramps: 1)
//       slopes the ground continuously instead of in terraces, over the
//       same rings x ring_width: crisp tilted facets from the core's edge
//       to the natural ground (a mound if the core is raised, a bowl if
//       sunk); shape Round or Square, ramps reach that much further along
//       the four axes (0 none, 1 twice as far).
//     plinth: false leaves the ground alone (centrepiece only).
//     form: "name", footprint: (60, 120)
//       grows a form on the whole footprint instead: the big plate at the
//       centre, scaled to that many metres from its centre to its furthest
//       corner (the core then fits around it).
//   Sites stream in within 2.5 km of you; `--opt nosites` leaves them out.
//
// COLOSSI: the same rules on a much coarser grid, for megastructures.
//   colossus_grid: (spacing: 2048, chance: 0.85)
//   colossi: [ (district: Stacks, form: "name", footprint: (90, 160), ...), ... ]
//   Ordinary sites keep clear of them; they stream in within 4.5 km.
//   Changing the sites regenerates the terrain, which takes a few seconds.
(
    modules: {
        "floor": Slab(thickness: 0.2),
        "roof": Slab(thickness: 0.15, at: Top),
        "pier": Column(width: 0.35),
        "needle": Column(width: 0.12),
        "blade": Fin(thickness: 0.08),
        "blade_z": Fin(thickness: 0.08, axis: Z),
        "cage": Frame(bar: 0.08),
        "steps": Stairs(rise: 0.45),

        // A low block with a ramp running up from its top.
        "terrace": Group([
            (min: (-1, -1, -1), max: (1, -0.4, 1), module: "box"),
            (min: (-1, -0.4, -1), max: (1, 0.3, 1), module: "ramp"),
        ]),
        // Two piers carrying a lintel.
        "gate": Group([
            (min: (-1, -1, -1), max: (-0.55, 1, 1), module: "box"),
            (min: (0.55, -1, -1), max: (1, 1, 1), module: "box"),
            (min: (-0.55, 0.5, -1), max: (0.55, 1, 1), module: "box"),
        ]),
        // A stack of thin slabs.
        "louvres": Group([
            (min: (-1, -1, -1), max: (1, -0.85, 1), module: "box"),
            (min: (-1, -0.45, -1), max: (1, -0.3, 1), module: "box"),
            (min: (-1, 0.1, -1), max: (1, 0.25, 1), module: "box"),
            (min: (-1, 0.65, -1), max: (1, 0.8, 1), module: "box"),
        ]),
        // A slab on four needles, like a table.
        "table": Group([
            (min: (-1, 0.6, -1), max: (1, 1, 1), module: "box"),
            (min: (-1, -1, -1), max: (-0.7, 0.6, -0.7), module: "box"),
            (min: (0.7, -1, -1), max: (1, 0.6, -0.7), module: "box"),
            (min: (-1, -1, 0.7), max: (-0.7, 0.6, 1), module: "box"),
            (min: (0.7, -1, 0.7), max: (1, 0.6, 1), module: "box"),
        ]),

        // Whole structures, for filling the plots of a region.
        "plot_ziggurat": Structure(style: "ziggurat", height: (0.25, 0.45)),
        "plot_spire": Structure(style: "spire", height: (0.7, 1.0)),
        "plot_hall": Structure(style: "hall", height: (0.12, 0.2)),
        "plot_tables": Structure(style: "tables", height: (0.2, 0.35)),
        "plot_fins": Structure(style: "fins", height: (0.15, 0.3)),
        "plot_lattice": Structure(style: "lattice", height: (0.2, 0.4)),
        // A thin paved plate covering the plot (2 m in a 200 m high region).
        "plaza": Slab(thickness: 0.01),
    },

    styles: {
        // Lab: an open lattice tower of frames (BLAME!'s trusses).
        "truss": (
            divisions: (2, 6, 2), keep: All, depth: 2, gap: 0.96, albedo: 0.1,
            leaves: [
                (on: Any, module: "cage", weight: 6),
                (on: Bottom, module: "box", weight: 1),
                (on: Early, module: "box", weight: 2),
            ],
        ),
        // The spire's recipe, a little lighter, for colossal needles.
        "needle": (
            divisions: (3, 5, 3), keep: Lattice, depth: 3, gap: 0.9, twist: 6,
            stop_chance: 0.3, albedo: 0.1,
            leaves: [
                (on: Corner, module: "needle", weight: 1),
                (on: Corner, module: "box", weight: 1),
                (on: Edge, module: "blade", weight: 1, turn: Random),
                (on: Edge, module: "louvres", weight: 1),
                (on: Early, module: "box", weight: 3),
            ],
        ),
        // Town buildings: a lattice of floors, needles and blades at the
        // corners and edges, louvres on the faces, cages inside.
        "tower_block": (
            divisions: (3, 5, 3), keep: Lattice, depth: 2, gap: 0.9,
            stop_chance: 0.25, albedo: 0.12, albedo_spread: 0.05,
            leaves: [
                (on: Corner, module: "needle", weight: 1),
                (on: Corner, module: "box", weight: 2),
                (on: Edge, module: "blade", weight: 1, turn: Random),
                (on: Edge, module: "louvres", weight: 2),
                (on: Interior, module: "cage", weight: 1),
                (on: Early, module: "box", weight: 3),
            ],
        ),
        // A lower, wider mass with voids, louvres and fins.
        "slab_block": (
            divisions: (4, 3, 2), keep: Random(0.8), depth: 2, gap: 0.92,
            stop_chance: 0.3, albedo: 0.14, albedo_spread: 0.05,
            leaves: [
                (on: Top, module: "terrace", weight: 1, turn: Outward),
                (on: Outside, module: "louvres", weight: 2),
                (on: Outside, module: "blade", weight: 1),
                (on: Early, module: "box", weight: 3),
                (on: Any, module: "box", weight: 2),
            ],
        ),
        // A Menger-like lattice; its interior cells become open cages.
        "lattice": (
            divisions: (3, 3, 3), keep: Lattice, depth: 3, gap: 0.93, twist: 2,
            stop_chance: 0.15, albedo: 0.13,
            leaves: [
                (on: Any, module: "box", weight: 3),
                (on: Interior, module: "cage", weight: 2),
                (on: Top, module: "louvres", weight: 1),
            ],
        ),
        // A tall twisting tower of blades and louvres around solid cores.
        "spire": (
            divisions: (3, 6, 3), keep: Lattice, depth: 3, gap: 0.9, twist: 10,
            stop_chance: 0.2, albedo: 0.1,
            leaves: [
                (on: Corner, module: "needle", weight: 1),
                (on: Corner, module: "box", weight: 1),
                (on: Edge, module: "blade", weight: 1, turn: Random),
                (on: Edge, module: "louvres", weight: 1),
                (on: Early, module: "box", weight: 3),
            ],
        ),
        // Piers carrying roofs, arcades within arcades, with gates.
        "hall": (
            divisions: (5, 2, 3), keep: ColumnsAndRoof, depth: 3, gap: 0.95,
            stop_chance: 0.1, albedo: 0.16,
            leaves: [
                (on: Top, module: "roof", weight: 2),
                (on: Top, module: "box", weight: 1),
                (on: Corner, module: "pier", weight: 2),
                (on: Edge, module: "gate", weight: 2, turn: Outward),
                (on: Any, module: "box", weight: 1),
            ],
        ),
        // Stepped massing climbed by ramps and stairs that face outwards.
        "ziggurat": (
            divisions: (4, 4, 4), keep: Skyline, depth: 2, gap: 0.92,
            stop_chance: 0.2, albedo: 0.14,
            leaves: [
                (on: Top, module: "terrace", weight: 2, turn: Outward),
                (on: Top, module: "steps", weight: 1, turn: Outward),
                (on: Any, module: "box", weight: 2),
            ],
        ),
        // A block whose faces are rows of blades: a brise-soleil facade.
        "fins": (
            divisions: (6, 4, 2), keep: All, depth: 2, gap: 0.97, albedo: 0.18,
            leaves: [
                (on: Outside, module: "blade", weight: 2),
                (on: Outside, module: "blade_z", weight: 1),
                (on: Interior, module: "void"),
                (on: Bottom, module: "box", weight: 1),
            ],
        ),
        // Lab: a mountain of mountains. Every split keeps columns falling
        // from the centre to broken edges, so the massif is made of smaller
        // massifs down to a few metres; ramps rising inwards on the summits.
        "massif": (
            divisions: (4, 3, 4), keep: Massif(0.85), depth: 3, gap: 0.96,
            stop_chance: 0.03, min_size: 3, albedo: 0.12, albedo_spread: 0.04,
            leaves: [
                (on: Summit, module: "ramp", weight: 2, turn: Inward),
                (on: Summit, module: "box", weight: 2),
                (on: Outside, module: "louvres", weight: 1),
                (on: Early, module: "box", weight: 3),
                (on: Any, module: "box", weight: 3),
            ],
        ),
        // Rougher: thirds, steeper falls, children lifted and turned a little.
        "massif_rough": (
            divisions: (3, 3, 3), keep: Massif(1.0), depth: 4, gap: 0.9, twist: 3,
            stop_chance: 0.1, lift: 0.12, min_size: 1.5, albedo: 0.11, albedo_spread: 0.05,
            leaves: [
                (on: Summit, module: "ramp", weight: 1, turn: Inward),
                (on: Corner, module: "needle", weight: 1),
                (on: Edge, module: "blade", weight: 1, turn: Random),
                (on: Early, module: "box", weight: 3),
                (on: Any, module: "box", weight: 3),
            ],
        ),
        // A loose stack of tables and cages.
        "tables": (
            divisions: (3, 3, 3), keep: Random(0.55), depth: 3, gap: 0.92, twist: -4,
            stop_chance: 0.25, lift: 0.15, albedo: 0.11,
            leaves: [
                (on: Any, module: "table", weight: 2),
                (on: Any, module: "cage", weight: 1),
                (on: Early, module: "box", weight: 2),
            ],
        ),

        // A region: a 5 x 5 grid of plots separated by streets (the gap),
        // each plot a structure, a plaza, or left empty. Spires gather in the
        // middle; facades of fins line the edges.
        "quarter": (
            divisions: (5, 1, 5), keep: All, depth: 1, gap: 0.82, albedo: 0.15,
            leaves: [
                (on: Interior, module: "plot_spire", weight: 1),
                (on: Interior, module: "plaza", weight: 1),
                (on: Edge, module: "plot_fins", weight: 1),
                (on: Any, module: "plot_ziggurat", weight: 2),
                (on: Any, module: "plot_hall", weight: 2),
                (on: Any, module: "plot_tables", weight: 1),
                (on: Any, module: "plot_lattice", weight: 1),
                (on: Any, module: "void", weight: 1),
            ],
        ),
    },

    structures: [
        (style: "lattice",  at: (1643, 978), size: (150, 90, 120), seed: 1),
        (style: "spire",    at: (1637, 791), size: (60, 340, 60),  seed: 2, yaw: 20),
        (style: "hall",     at: (1555, 623), size: (160, 50, 100), seed: 3, yaw: 35),
        (style: "ziggurat", at: (1411, 503), size: (60, 80, 140), seed: 4),
        (style: "fins",     at: (1231, 451), size: (140, 70, 40),  seed: 5, yaw: -10),
        (style: "tables",   at: (1046, 477), size: (120, 90, 120), seed: 6),
        // A 600 m region behind the spawn point (turn around to see it).
        (style: "quarter",  at: (900, 1450), size: (600, 200, 600), seed: 7),
    ],

    forms: {
        // ---- Lab candidates (see `lab:` at the end) ----
        // A blank shaft circled by projecting walkway rings.
        "lab_ring": Extrude(height: (1.2, 2), tone: 0.03, then: "lab_shaft_body"),
        "lab_shaft_body": Neck(by: (5, 7), height: (8, 22), then: "lab_shaft_next"),
        "lab_shaft_next": Choose([(40, "lab_ring"), (1, "lab_shaft_top")]),
        "lab_shaft_top": Inset(by: (5, 7), then: "c_crown_split"),
        // A bundle of pipe-like prisms of different heights.
        "lab_organ": Cells(size: 5, gap: 0.4, then: "lab_pipe"),
        "lab_pipe": Extrude(height: (20, 140), then: "lab_pipe_cap"),
        "lab_pipe_cap": Choose([(3, "nothing"), (1, "lab_pipe_crown")]),
        "lab_pipe_crown": Inset(by: (0.4, 0.8), then: "lab_pipe_crown_block"),
        "lab_pipe_crown_block": Extrude(height: (1, 4), tone: 0.03),
        // Slabs stacked, each shifted along the long axis: cantilevers.
        "lab_cant": Extrude(height: (5, 9), then: "lab_cant_next"),
        "lab_cant_next": Choose([(8, "lab_cant_shift"), (1, "nothing")]),
        "lab_cant_shift": Shift(by: (4, 10), along: true, then: "lab_cant"),
        // A slender stem carrying a wide cap.
        "lab_stem": Inset(by: (16, 19), then: "lab_stem_shaft"),
        "lab_stem_shaft": Extrude(height: (60, 110), then: "lab_cap"),
        "lab_cap": Extrude(height: (10, 16), taper: (-5, -4), then: "lab_cap_top"),
        "lab_cap_top": Extrude(height: (2, 4), taper: (0.15, 0.3)),
        // Earthworks and frames on a flat complex.
        "lab_heizer": Split(depth: 2, gap: 10, min_width: 20, then: "lab_heizer_piece"),
        "lab_heizer_piece": Choose([(3, "lab_berm"), (1, "lab_frame"), (1, "nothing")]),
        "lab_berm": Extrude(height: (6, 16), taper: (0.4, 0.7), tone: 0.02),
        "lab_frame": Rim(width: 2.5, height: (10, 18), gates: 1),
        // Vertebrae: segments of dense ribs with necks between.
        "lab_rib_seg": Facade(height: (6, 10), panel: 1.0, storey: 20, depth: (1, 2.5), fill: 0.9,
            then: "lab_rib_neck"),
        "lab_rib_neck": Neck(by: (2, 3.5), height: (1.5, 3), then: "lab_rib_next"),
        "lab_rib_next": Choose([(10, "lab_rib_seg"), (1, "nothing")]),

        // Blocks: a few storeys; the top may set back and rise again.
        "block": Facade(height: (5, 18), panel: 3, storey: 3.2, depth: (0.25, 1.1), fill: 0.6, then: "block_top"),
        "block_top": Choose([(4, "nothing"), (3, "setback"), (1, "parapet")]),
        "setback": Inset(by: (1.5, 5), then: "block"),
        "parapet": Rim(width: 0.5, height: (1.1, 1.1), gates: 0),
        "low_block": Inset(by: (3, 6), then: "block"),
        // A tall tower, slightly battered.
        "monolith": Facade(height: (12, 24), panel: 4, storey: 4, depth: (0.4, 1.6), fill: 0.55, tone: -0.03,
            then: "monolith_next"),
        "monolith_next": Choose([(4, "monolith_groove"), (1, "setback"), (1, "nothing")]),
        "monolith_groove": Neck(by: (0.8, 1.6), height: (1.2, 2.4), then: "monolith"),

        // Blocks cut along the plate's own lines, with streets between.
        "blocks": Split(depth: 2, gap: 2.5, min_width: 16, then: "block_or_gap"),
        "block_or_gap": Choose([(6, "town_tower"), (4, "town_slab"), (0.5, "nothing")]),
        // Buildings of the box styles in the pieces of a plate.
        "town_tower": Inset(by: (0.5, 1.5), then: "town_tower_box"),
        "town_tower_box": Structure(style: "tower_block", proportion: (2, 4.5)),
        "town_slab": Inset(by: (0.5, 1.5), then: "town_slab_box"),
        "town_slab_box": Structure(style: "slab_block", proportion: (0.4, 0.9)),
        // A screen of slender fins.
        "screen": Split(depth: 4, gap: 1.4, min_width: 2.5, then: "fin"),
        "fin": Extrude(height: (8, 22), tone: 0.02),
        // A walled court with a gate, and something inside.
        "court": Rim(width: 1.6, height: (5, 11), gates: 0.5, inner: "court_inside"),
        "court_inside": Choose([(2, "nothing"), (1, "low_block"), (1, "dais")]),
        // A stepped dais: low terraces, each a mantle or less.
        "dais": Extrude(height: (0.9, 1.8), then: "dais_up"),
        "dais_up": Choose([(3, "dais_step"), (1, "nothing"), (1, "low_block")]),
        "dais_step": Inset(by: (2.5, 5), then: "dais"),
        // Paving broken into small plates, some lifted.
        "paving": Cells(size: 6, gap: 0.5, then: "slab_or_not"),
        "slab_or_not": Choose([(3, "nothing"), (2, "slab")]),
        "slab": Extrude(height: (0.4, 1.4)),
        // An old box style on a plate.
        "lattice_block": Inset(by: (2, 4), then: "lattice_box"),
        "lattice_box": Structure(style: "lattice", height: (20, 50)),

        // Terrain pillars (the stacks' ground): the mesher grows this on each
        // pillar plate and scales it to the pillar's height. Banded shafts,
        // sometimes split by a slot, with grooves, setbacks and small crowns.
        "pillar": Choose([(3, "pillar_band"), (2, "pillar_split"), (1, "pillar_cells")]),
        "pillar_split": Split(depth: 1, gap: 0.6, min_width: 2.5, then: "pillar_band"),
        "pillar_cells": Cells(size: 2.5, gap: 0.3, then: "pillar_band"),
        "pillar_band": Facade(height: (2, 5), panel: 1.7, storey: 1.9, depth: (0.1, 0.5), fill: 0.45,
            then: "pillar_next"),
        "pillar_next": Choose([(6, "pillar_neck"), (2, "pillar_setback"), (1, "pillar_crown")]),
        "pillar_neck": Neck(by: (0.2, 0.5), height: (0.4, 1), then: "pillar_band"),
        "pillar_setback": Inset(by: (0.4, 1.2), then: "pillar_band"),
        "pillar_crown": Cells(size: 1.5, gap: 0.3, then: "pillar_crown_piece"),
        "pillar_crown_piece": Choose([(1, "nothing"), (2, "pillar_crown_block")]),
        "pillar_crown_block": Extrude(height: (0.5, 2.5), tone: 0.02),

        // What grows on a plate, by kind of site.
        "plaza": Choose([(6, "nothing"), (1, "dais"), (1, "court"), (1, "paving")]),
        "town": Inset(by: (0.5, 1.5), then: "town_plate"),
        "town_plate": Choose([(7, "blocks"), (1, "court"), (1, "dais"), (1, "nothing")]),
        "towers": Inset(by: (1.5, 4), then: "towers_plate"),
        "towers_plate": Choose([(3, "towers_spire"), (3, "blocks"), (1, "lattice_block"), (1, "nothing")]),
        "towers_spire": Structure(style: "tower_block", proportion: (3, 6)),
        "ruin": Choose([(3, "paving"), (1, "court"), (3, "nothing"), (1, "low_block"), (1, "dais")]),
        "terrace": Choose([(2, "paving"), (1, "court"), (2, "dais"), (1, "low_block")]),

        // Colossi: hundreds of metres, with detail at every scale.
        // Bands with grooves between them, now and then a setback, and a
        // crown when they stop.
        "c_band": Facade(height: (14, 32), panel: 8, storey: 6, depth: (0.8, 3), fill: 0.5, then: "c_band_next"),
        "c_band_next": Choose([(14, "c_groove"), (3, "c_setback"), (1, "c_crown")]),
        "c_groove": Neck(by: (1.2, 2.5), height: (2, 4), then: "c_band"),
        "c_setback": Inset(by: (4, 12), then: "c_band"),
        "c_crown": Choose([(2, "c_crown_split"), (1, "nothing")]),
        "c_crown_split": Split(depth: 2, gap: 3, min_width: 10, then: "c_crown_piece"),
        "c_crown_piece": Extrude(height: (6, 40), then: "c_crown_more"),
        "c_crown_more": Choose([(2, "nothing"), (1, "c_crown_up")]),
        "c_crown_up": Inset(by: (2, 5), then: "c_crown_piece"),

        // Stacks: colossal spires of the box style that works in the spire
        // site, two or so side by side, straight out of the mound.
        "colossus_needles": Inset(by: (5, 15), then: "needles"),
        "needles": Split(depth: 1, gap: 12, min_width: 35, then: "needle"),
        "needle": Choose([(4, "needle_spire"), (1, "needle_tall")]),
        "needle_spire": Structure(style: "needle", proportion: (4, 7)),
        "needle_tall": Structure(style: "needle", proportion: (7, 10)),

        // Tiers: a mountain of sloped tiers. Each tier battered back like a
        // pyramid's face; each ledge carries platforms and blocks along its
        // edge, broken by gaps; sometimes twin peaks; a crown or a tower on top.
        "colossus_mountain": Extrude(height: (25, 45), taper: (0.12, 0.25), tone: -0.02, then: "mountain_ledge"),
        "mountain_ledge": Rim(width: 12, gates: 0.35, wall: "mountain_deco", inner: "mountain_up"),
        "mountain_up": Choose([(6, "colossus_mountain"), (1, "mountain_split"), (1, "mountain_crown")]),
        "mountain_split": Split(depth: 1, gap: 10, min_width: 40, then: "colossus_mountain"),
        "mountain_crown": Choose([(1, "c_crown_split"), (1, "towers_spire")]),
        "mountain_deco": Choose([(2, "nothing"), (3, "mountain_blocks"), (1, "mountain_platform")]),
        "mountain_blocks": Split(depth: 2, gap: 2, min_width: 8, then: "mountain_block"),
        "mountain_block": Choose([(3, "town_slab"), (1, "town_tower"), (1, "nothing")]),
        "mountain_platform": Extrude(height: (1.5, 4)),

        // Floor: a vast walled enclosure, banded walls broken by gates, and
        // something inside.
        "colossus_enclosure": Rim(width: 14, gates: 0.6, wall: "w_band", inner: "enclosure_inside"),
        "w_band": Facade(height: (10, 22), panel: 5, storey: 4.5, depth: (0.5, 1.8), fill: 0.5, then: "w_next"),
        "w_next": Choose([(5, "w_groove"), (1, "nothing")]),
        "w_groove": Neck(by: (0.8, 1.5), height: (1.5, 3), then: "w_band"),
        "enclosure_inside": Choose([(2, "lone_needle"), (1, "lone_mountain"), (1, "nothing")]),
        "lone_needle": Inset(by: (50, 90), then: "c_band"),
        "lone_mountain": Inset(by: (40, 70), then: "colossus_mountain"),

        // Broken: a shattered field of shafts, some bent as they rise.
        "colossus_ruin": Cells(size: 45, gap: 6, then: "ruin_shaft"),
        "ruin_shaft": Choose([(2, "c_band"), (2, "r_band"), (2, "ruin_stub"), (2, "nothing")]),
        "r_band": Extrude(height: (14, 32), lean: 3, then: "r_next"),
        "r_next": Choose([(10, "r_groove"), (1, "c_crown")]),
        "r_groove": Neck(by: (1, 2), height: (2, 4), then: "r_band"),
        "ruin_stub": Extrude(height: (10, 60), taper: (0, 0.4), lean: 6, then: "c_crown_split"),
    },

    site_grid: (spacing: 768, chance: 0.55),
    sites: [
        // Floor: vast plazas and towns on low square platforms with ramps;
        // the odd hall.
        (district: Floor, weight: 3, plates: "plaza", terraces: "terrace", core: (70, 130),
            lift: (1.5, 5), rings: 2, ring_width: 30, earthwork: (shape: Square, ramps: 1)),
        (district: Floor, weight: 2, plates: "town", terraces: "terrace", core: (80, 140),
            lift: (3, 8), rings: 2, ring_width: 30, earthwork: (shape: Square, ramps: 1)),
        (district: Floor, weight: 1, style: "hall", size: ((120, 30, 80), (220, 60, 140)), plates: "plaza",
            terraces: "terrace", lift: (1.5, 5), rings: 2, ring_width: 30, earthwork: (shape: Square, ramps: 0.6)),
        // Tiers: high stepped mounds in mantle-height steps, crowned.
        (district: Tiers, weight: 2, style: "ziggurat", size: ((60, 50, 80), (140, 110, 180)), plates: "ruin",
            terraces: "terrace", terrace_chance: 0.5, lift: (8, 16), rings: 5, ring_width: 16, step: 2),
        (district: Tiers, weight: 2, plates: "town", terraces: "terrace", terrace_chance: 0.5, core: (50, 90),
            lift: (8, 16), rings: 5, ring_width: 16, step: 2),
        // Stacks: towers on round mounds among the pillars.
        (district: Stacks, weight: 3, plates: "towers", terraces: "ruin", core: (50, 100), lift: (4, 10),
            earthwork: (shape: Round)),
        (district: Stacks, weight: 1, style: "spire", size: ((40, 200, 40), (80, 420, 80)), plates: "towers",
            terraces: "ruin", lift: (4, 10), earthwork: (shape: Round, ramps: 0.5)),
        // Broken: ruins on mounds or sunk into bowls.
        (district: Broken, weight: 3, plates: "ruin", terraces: "ruin", core: (60, 110), lift: (-10, 8),
            earthwork: (shape: Round)),
        (district: Broken, weight: 1, plates: "town", terraces: "ruin", core: (60, 100), lift: (-8, 4),
            earthwork: (shape: Square)),
        (district: Broken, weight: 1, style: "lattice", size: ((100, 60, 100), (180, 120, 180)), plates: "ruin",
            terraces: "ruin", lift: (-10, 8), earthwork: (shape: Round, ramps: 0.4)),
    ],

    colossus_grid: (spacing: 2048, chance: 0.85),
    colossi: [
        // Each colossus emerges from an earthwork: needles from square
        // mounds with ramps, mountains from round ones, enclosures sunk in
        // square bowls, shattered shafts from low mounds.
        (district: Stacks, form: "colossus_needles", footprint: (90, 160), lift: (12, 25), rings: 3, ring_width: 30,
            terraces: "ruin", earthwork: (shape: Square, ramps: 0.6)),
        (district: Tiers, form: "colossus_mountain", footprint: (140, 220), lift: (10, 20), rings: 4, ring_width: 24,
            step: 2, terraces: "terrace", terrace_chance: 0.5, earthwork: (shape: Round, ramps: 1)),
        (district: Floor, form: "colossus_enclosure", footprint: (180, 260), lift: (-10, -4), rings: 2, ring_width: 40,
            terraces: "terrace", earthwork: (shape: Square)),
        (district: Broken, form: "colossus_ruin", footprint: (140, 220), lift: (8, 18), rings: 3, ring_width: 30,
            terraces: "ruin", earthwork: (shape: Round, ramps: 0.3)),
    ],

    // Pipework that belongs to structures (see dressing.rs): bundles of
    // ducts rising along faces (from the ground or partway up) with collars
    // and junction boxes, turning into walls or running along them; bundles
    // spanning gaps to the mass facing them; cables sagging between tops.
    //   pipes: chance per open face   bundle: pipes per bundle   width: metres
    //   collars: flange spacing (0 none)   brackets: bracket/clamp spacing
    //   members: chance a long thin piece carries pipes along it, clamped
    //   junctions, spans, cables: chances
    dressings: {
        "industrial": (pipes: 0.35, bundle: (1, 3), width: (0.4, 1.2), collars: 6, brackets: 3.5,
            junctions: 0.25, spans: 0.35, cables: 0.3, members: 0.35),
    },

    // The lab (`--opt lab`): candidate patterns in a row on flat ground,
    // judged on their own. `form` + `footprint` (metres to the corners), or
    // `style` + `size`; `dress` adds pipework; `variants` samples side by
    // side; `note` says what each tries.
    // Batch 1: organ kept; shaft_rings, cantilever_stack, earthworks,
    //   mountain, truss, ribbed promising (lacking detail); stem_cap dropped.
    // Batch 2 (pipework): reads as structure on the truss (at a distance)
    //   and could on the mountain; cosmetic on the ring shaft, cantilever
    //   stack and spire; add-ons or errors on the ribbed vertebrae (giger).
    // Batch 3: pipework with round pipes, brackets, flanges and plates,
    //   along members, on the truss, mountain and organ only.
    lab: [
        (name: "truss", style: "truss", size: (40, 160, 40), variants: 1, note: "Bare"),
        (name: "truss_dressed", style: "truss", size: (40, 160, 40), dress: "industrial",
            note: "Pipes along its members, clamped; rising pipes with brackets; cables"),
        (name: "mountain", form: "colossus_mountain", footprint: 120, variants: 1,
            note: "The old sloped mountain, for comparison"),
        (name: "massif", style: "massif", size: (150, 120, 150),
            note: "A mountain of mountains: the same falling envelope at every scale"),
        (name: "organ", form: "lab_organ", footprint: 35, variants: 1, note: "Bare (kept)"),
        (name: "organ_dressed", form: "lab_organ", footprint: 35, dress: "industrial",
            note: "The organ with pipework"),
    ],
)
