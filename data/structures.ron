        // Sunk relief (lab): faces carved into themselves, recesses within
        // recesses.
        "relief_block": Relief(height: (45, 65), depth: 2.5, then: "relief_setback"),
        "relief_setback": Inset(by: (5, 9), then: "relief_upper"),
        "relief_upper": Relief(height: (20, 35), depth: 2),
        "relief_wall": Relief(height: (30, 40), depth: 2.5),
        // Pipes in grooves (lab): the wall network sunk into a core, only
        // the crowns showing.
        "sunk_block": Rack(height: (40, 55), depth: (2.5, 3.5), core: true, strange: true, sunk: true),
        // Square conduits (lab): standing off the wall, and sunk into it.
        "square_block": Rack(height: (40, 55), depth: (2.5, 3.5), core: true, strange: true, square: true),
        "square_sunk": Rack(height: (40, 55), depth: (2.5, 3.5), core: true, strange: true, square: true, sunk: true),
        // Curtains (lab): wiring in its own right, sheaves of long cables
        // across an open shaft (after the Citadel in Half-Life 2).
        "citadel": Curtains(height: (90, 130)),
        // Bastions (lab): bare round walls given scale by human-sized
        // things: deep arches, a door, a spiral stair, bridges.
        // Ordered towers (lab), transcribed from Manifold Garden: one, and
